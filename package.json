{
  "name": "cyc.earth",
  "version": "0.0.1",
  "private": true,
  "license": "GPL-3.0-only",
  "scripts": {
    "dev": "bun --bun next dev",
    "build": "bun --bun next build",
    "start": "bun --bun next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check && bun run tailwind:lint",
    "format": "biome check --write",
    "tailwind:lint": "tailwind-lint --config src/_app/styles/globals.css",
    "tailwind:fix": "tailwind-lint --config src/_app/styles/globals.css --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@mapbox/mapbox-gl-language": "^1.0.1",
    "@mapbox/polyline": "^1.2.1",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.64.0",
    "mapbox-gl": "^3.33.0",
    "next": "16.4.3",
    "next-intl": "^4.14.9",
    "next-themes": "0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@tailwindcss/turbopack": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "commitizen": "4.3.2",
    "cz-git": "1.14.0",
    "jsdom": "^30.1.3",
    "lefthook": "2.2.2",
    "tailwind-lint": "0.16.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "lefthook",
    "sharp",
    "unrs-resolver"
  ],
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  }
}
